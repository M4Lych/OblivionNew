<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:padding="24dp" android:background="@color/background">
    <LinearLayout android:id="@+id/splash_brand" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/splash_footer" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <ImageView android:id="@+id/imgLeaf" android:layout_width="104dp" android:layout_height="104dp" android:padding="24dp" android:background="@drawable/bg_splash_ring" android:src="@drawable/ic_leaf_logo" android:contentDescription="@string/splash_logo_desc" />
        <TextView android:id="@+id/tvAppName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="@string/app_name" android:textSize="26sp" android:letterSpacing="0.08" android:fontFamily="sans-serif-medium" android:textStyle="bold" android:textColor="@color/accent_text" android:includeFontPadding="false" />
        <View android:layout_width="120dp" android:layout_height="2dp" android:layout_marginTop="14dp" android:background="@color/accent_text" />
    </LinearLayout>
    <LinearLayout android:id="@+id/splash_footer" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginBottom="48dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:id="@+id/tvPreparing" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/splash_opening" android:textSize="11sp" android:textColor="@color/text_secondary" />
            <ProgressBar android:id="@+id/loadingBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="112dp" android:layout_height="3dp" android:layout_marginTop="8dp" android:indeterminate="true" android:indeterminateTint="@color/primary" />
        </LinearLayout>
        <TextView android:id="@+id/tvVersion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:textSize="11sp" android:fontFamily="monospace" android:textColor="@color/text_secondary" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
