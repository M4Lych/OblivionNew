<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shell_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="horizontal"
    android:tag="levi_keep_background">

    <LinearLayout
        android:id="@+id/nav_bar_root"
        android:layout_width="56dp"
        android:layout_height="match_parent"
        android:background="@color/ui_chrome"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/nav_back_button"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginTop="0dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_back"
            android:padding="2dp"
            android:src="@drawable/ic_ui_arrow_back"
            android:tooltipText="@string/nav_back"
            app:tint="@color/ui_muted" />

        <ImageView
            android:id="@+id/nav_logo"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="2dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_leaf_logo" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:background="@color/divider" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/nav_tab_launch"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:contentDescription="@string/nav_launch"
                    android:drawableTop="@drawable/ic_nav_launch"
                    android:drawablePadding="3dp"
                    android:gravity="center"
                    android:letterSpacing="0"
                    android:maxLines="1"
                    android:paddingTop="8dp"
                    android:paddingBottom="6dp"
                    android:text="@string/nav_launch"
                    android:textAllCaps="false"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/nav_tab_download"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:contentDescription="@string/nav_download"
                    android:drawableTop="@drawable/ic_nav_download"
                    android:drawablePadding="3dp"
                    android:gravity="center"
                    android:letterSpacing="0"
                    android:maxLines="1"
                    android:paddingTop="8dp"
                    android:paddingBottom="6dp"
                    android:text="@string/nav_download"
                    android:textAllCaps="false"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/nav_tab_instances"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:contentDescription="@string/nav_instances"
                    android:drawableTop="@drawable/ic_nav_instances"
                    android:drawablePadding="3dp"
                    android:gravity="center"
                    android:letterSpacing="0"
                    android:maxLines="1"
                    android:paddingTop="8dp"
                    android:paddingBottom="6dp"
                    android:text="@string/nav_instances"
                    android:textAllCaps="false"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/nav_tab_about"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:contentDescription="@string/nav_about"
                    android:drawableTop="@drawable/ic_nav_about"
                    android:drawablePadding="3dp"
                    android:gravity="center"
                    android:letterSpacing="0"
                    android:maxLines="1"
                    android:paddingTop="8dp"
                    android:paddingBottom="6dp"
                    android:text="@string/nav_about"
                    android:textAllCaps="false"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/nav_tab_settings"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:contentDescription="@string/nav_settings"
                    android:drawableTop="@drawable/ic_nav_settings"
                    android:drawablePadding="3dp"
                    android:gravity="center"
                    android:letterSpacing="0"
                    android:maxLines="1"
                    android:paddingTop="8dp"
                    android:paddingBottom="6dp"
                    android:text="@string/nav_settings"
                    android:textAllCaps="false"
                    android:textSize="9sp" />
            </LinearLayout>
        </ScrollView>

        <include layout="@layout/shell_account_cluster_side" />

        <ImageView
            android:id="@+id/nav_theme_toggle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_toggle_theme"
            android:padding="6dp"
            android:src="@drawable/ic_sun"
            android:tooltipText="@string/nav_toggle_theme"
            app:tint="@color/ui_muted" />
    </LinearLayout>

    <View
        android:id="@+id/nav_divider"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/ui_card_stroke" />

    <FrameLayout
        android:id="@+id/shell_content"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:descendantFocusability="beforeDescendants"
        android:focusable="true"
        android:focusableInTouchMode="true" />
</LinearLayout>
