<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:keepScreenOn="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <ImageView
            android:id="@+id/minecraftLaunchLogo"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_oblivion_logo" />

        <TextView
            android:id="@+id/minecraftLaunchStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-black"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:text="@string/minecraft_loading_title"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/minecraftLaunchDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#E6FFFFFF"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/minecraftLaunchProgress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="280dp"
            android:layout_height="5dp"
            android:layout_marginTop="16dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/bg_loading_progress" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/minecraftLaunchReturn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/minecraft_loading_return"
                android:textAllCaps="false"
                android:visibility="gone" />

            <Button
                android:id="@+id/minecraftLaunchCopyLog"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/minecraft_loading_copy_log"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:visibility="gone" />

            <Button
                android:id="@+id/minecraftLaunchSaveLog"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/oblivion_save_log"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/minecraftLaunchLogScroll"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="96dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="18dp"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/minecraftLaunchLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="11sp" />
    </ScrollView>

    <TextView
        android:id="@+id/minecraftLaunchLogToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="18dp"
        android:background="#66000000"
        android:fontFamily="sans-serif-black"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:text="@string/oblivion_logs"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/minecraftLaunchCancel"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="14dp"
        android:background="#66000000"
        android:contentDescription="@string/cancel"
        android:padding="11dp"
        android:src="@drawable/ic_close" />
</FrameLayout>
