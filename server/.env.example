# Discord application (https://discord.com/developers/applications): OAuth2 redirect must be
#   <PUBLIC_BASE_URL>/v1/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
GUILD_ID=
PUBLIC_BASE_URL=https://api.example.com
# Discord role id -> Oblivion role key (oblivion, admin, staff, creator, partner, oblivion_plus, member, newcomer)
ROLE_MAP={"111111111111111111":"admin","222222222222222222":"staff","333333333333333333":"oblivion_plus"}
# Roles allowed to create claim codes with the bot / admin API (Oblivion role keys)
CODE_CREATOR_ROLES=oblivion,admin,staff
ADMIN_KEY=change-me-long-random
SIGNING_KEY_PATH=signing_key.pem
DB_PATH=oblivion.db
PACKAGES_DIR=packages
